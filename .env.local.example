# Backend WordPress (plugin TakeALawyer Core).
#
# Les deux valeurs se lisent dans WordPress : menu Avocats → Réglages.
# Copiez ce fichier en .env.local — qui est ignoré par git — et renseignez-les.
#
# Aucune des deux ne porte le préfixe NEXT_PUBLIC_ : c'est délibéré. La clé
# autorise la création de comptes ; exposée au navigateur, elle permettrait à
# n'importe qui de remplir l'annuaire de faux cabinets. Elle ne doit être lue
# que par les Route Handlers de app/api/avocats/.

TAL_API_URL=http://localhost/simplyprint/wp-json/tal/v1
TAL_API_KEY=tal_live_remplacez_par_votre_cle
