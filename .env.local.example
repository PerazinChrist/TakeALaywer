# ============================================================================
# Backend WordPress (plugin TakeALawyer Core)
# ============================================================================
#
# Les deux valeurs se lisent dans WordPress : menu Avocats → Réglages.
# Copiez ce fichier en .env.local — qui est ignoré par git — et renseignez-les.
#
# Aucune des deux ne porte le préfixe NEXT_PUBLIC_ : c'est délibéré. La clé
# autorise la création de comptes ; exposée au navigateur, elle permettrait à
# n'importe qui de remplir l'annuaire de faux cabinets. Elle ne doit être lue
# que par les Route Handlers de app/api/avocats/.

TAL_API_URL=http://localhost/simplyprint/wp-json/tal/v1
TAL_API_KEY=tal_live_remplacez_par_votre_cle

# En ligne, ces deux valeurs changent — et la clé n'est PAS la même qu'en local :
# chaque installation WordPress génère la sienne.
#
#   TAL_API_URL=https://externalisation-comptables.com/wp-json/tal/v1
#   TAL_API_KEY=<Avocats → Réglages, sur le WordPress en ligne>
#
# Sur un hébergement en permaliens « simples », /wp-json/ n'existe pas. L'écran
# Réglages affiche alors la forme de repli à recopier telle quelle :
#
#   TAL_API_URL=https://externalisation-comptables.com/?rest_route=/tal/v1
#
# Sur une plateforme d'hébergement (Vercel, Netlify, o2switch…), ces variables se
# déclarent dans l'interface du prestataire, pas dans un fichier : .env.local
# n'est pas déployé, et un fichier d'environnement versionné exposerait la clé.


# ============================================================================
# Paiement Mobile Money — CamPay (MTN Mobile Money, Orange Money)
# ============================================================================
#
# Documentation : https://documenter.getpostman.com/view/2391374/T1LV8PVA
#
# Où trouver ces valeurs :
#   1. Créez un compte sur https://demo.campay.net (bac à sable) ou
#      https://www.campay.net (production).
#   2. Menu « Applications » → créez une application.
#   3. Section « APP KEYS » : les identifiants ci-dessous s'y trouvent tous.
#
# ⚠️ Aucune de ces variables ne porte NEXT_PUBLIC_, et aucune ne doit le porter.
#    Ce couple username/password ne sert pas qu'à encaisser : il autorise aussi
#    les retraits (/api/withdraw/). Publié dans le bundle du navigateur, il
#    permettrait de vider le solde du compte. Seuls les Route Handlers de
#    app/api/paiements/ ont le droit de les lire.

# Environnement. Bac à sable : https://demo.campay.net
#                Production  : https://www.campay.net
# Les identifiants ne sont PAS communs aux deux : croiser une clé de démo avec
# l'URL de production donne une 401 qui ressemble à un mot de passe erroné.
CAMPAY_BASE_URL=https://demo.campay.net

# Méthode recommandée — jeton temporaire (1 h), renouvelé automatiquement.
CAMPAY_APP_USERNAME=remplacez_par_votre_app_username
CAMPAY_APP_PASSWORD=remplacez_par_votre_app_password

# Méthode alternative — jeton permanent de la section APP KEYS.
# S'il est renseigné, il prend le pas sur le couple ci-dessus. Pratique pour un
# test rapide, déconseillé en production : il n'expire jamais, donc une fuite
# reste exploitable jusqu'à révocation manuelle dans le tableau de bord.
# CAMPAY_PERMANENT_TOKEN=

# Clé de signature des rappels serveur (« Webhook key » dans APP KEYS).
# Sans elle, /api/paiements/campay/webhook rejette tous les rappels : l'URL est
# publique, et une notification non signée pourrait être fabriquée par n'importe
# qui pour s'offrir un guide.
CAMPAY_WEBHOOK_KEY=remplacez_par_votre_webhook_key

# Devise des transactions. CamPay n'encaisse qu'en francs CFA.
CAMPAY_CURRENCY=XAF

# ----------------------------------------------------------------------------
# À déclarer dans le tableau de bord CamPay, section « Callback URL » :
#
#   https://votre-domaine.tld/api/paiements/campay/webhook
#
# La méthode GET comme POST fonctionne — les deux sont gérées.
# En développement local, CamPay ne peut pas joindre localhost : passez par un
# tunnel (ngrok, cloudflared) ou laissez la page de paiement interroger le
# statut elle-même, ce qu'elle fait déjà.
# ----------------------------------------------------------------------------
